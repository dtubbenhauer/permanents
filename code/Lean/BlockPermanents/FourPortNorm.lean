import BlockPermanents.FourLastCaps
import BlockPermanents.FourQuadratic

/-! # Inverse-Gram projection bound for the actual word-coordinate ports -/
namespace BlockPermanents.FourLastCaps
open Matrix Bend
open scoped BigOperators Matrix ComplexOrder
noncomputable section
variable {D J : Type*} [Fintype D] [DecidableEq D] [Fintype J] [DecidableEq J]

abbrev Raw (D : Type*) := (Option (Fin 4) → D) → D → ℂ

def rawEnergy (S : Finset D) (z : Raw D) : ℝ := ∑ w, ∑ c ∈ S, Complex.normSq (z w c)

omit [DecidableEq D] in
private theorem real_pair_sub (S : Finset D) (z u : Raw D) :
    rawEnergy S z - 2*(rawPair S u z).re + (rawPair S u u).re =
      rawEnergy S (fun w c => z w c-u w c) := by
  simp only [rawEnergy, rawPair, Complex.re_sum, Complex.normSq_sub, Finset.sum_sub_distrib,
    Finset.sum_add_distrib, ← Finset.mul_sum, starRingEnd_apply]
  have hw (x y : ℂ) : ((star y) * x).re = (x * (starRingEnd ℂ) y).re := congrArg _ (mul_comm _ _)
  simp_rw [hw]
  have hn (x : ℂ) : (x*(starRingEnd ℂ) x).re = Complex.normSq x := by
    rw [mul_comm, ← Complex.normSq_eq_conj_mul_self, Complex.ofReal_re]
  simp_rw [hn]; simp only [starRingEnd_apply]; ring

omit [DecidableEq D] in
private theorem original_dominates (S : Finset D) (z u : Raw D)
    (h : rawPair S u z = rawPair S u u) : (rawPair S u z).re ≤ rawEnergy S z := by
  have hn : 0 ≤ rawEnergy S (fun w c => z w c-u w c) :=
    Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg fun _ _ => Complex.normSq_nonneg _)
  rw [← real_pair_sub, ← h] at hn
  linarith

omit [Fintype D] [DecidableEq D] [DecidableEq J] in
theorem cap_sum (S : Finset D) (P : Finset (Option (Fin 4))) (v : J → Raw D) (w : Fin 4 → D) :
    portCap S P (fun t c => ∑ i, v i t c) w = ∑ i, portCap S P (v i) w := by
  unfold portCap
  rw [← Finset.mul_sum]
  congr 1
  rw [Finset.sum_comm (s := (_ : Finset J))]
  apply Finset.sum_congr rfl; intro σ _
  rw [Finset.sum_comm (s := (_ : Finset J))]
  apply Finset.sum_congr rfl; intro a _; exact Finset.sum_comm

/-- The whole port row occupies disjoint sets of slots of the indicated
sizes. Only the displayed equalities that identify the row outputs enter;
its Gram, inverse and orthogonal error are derived from the actual caps. -/
theorem word_port_bound (S : Finset D) (hS : S.card = 2) (P : J → Finset (Option (Fin 4))) (d : J → ℕ)
    (hs : ∀ i, (P i).card = d i+1) (hd : ∀ i j, i≠j → Disjoint (P i) (P j))
    (z : Raw D) (y : Multiset D → J → ℂ) (hy : ∀ i w, portCap S (P i) z w = y (occupation w) i) :
    (∑ w : Fin 4 → D, (quadratic (Routings.capGram d 2 (density S w))⁻¹ (y (occupation w))).re) ≤ rawEnergy S z := by
  let τ (B : Multiset D) := ((Routings.capGram d 2 (bagDensity S B))⁻¹).mulVec (y B)
  let u : Raw D := fun t c => ∑ i, portCup (P i) (fun B => τ B i) t c
  have hu (i : J) (w : Fin 4 → D) : portCap S (P i) u w = y (occupation w) i := by
    unfold u
    rw [cap_sum]
    simp_rw [port_gluing_gram S P d hs hd, hS, Nat.cast_ofNat]
    change (Routings.capGram d 2 (density S w)).mulVec (τ (occupation w)) i = _
    unfold τ
    rw [bagDensity_word, Matrix.mulVec_mulVec]
    let G := Routings.capGram d 2 (density S w)
    have pos := Routings.capGram_posDef d 2 (density S w) (density_nonneg S w) (by linarith [density_le_one S w])
    have hdet := (Matrix.isUnit_iff_isUnit_det _).mp pos.isUnit
    rw [Matrix.mul_nonsing_inv _ hdet, Matrix.one_mulVec]
  have uv : rawPair S u z = rawPair S u u := by
    calc
      rawPair S u z = ∑ i, outPair (fun B => τ B i) (portCap S (P i) z) := by
        unfold u; rw [raw_sum_left]; simp_rw [port_adjoint]
      _ = ∑ i, outPair (fun B => τ B i) (portCap S (P i) u) := by
        apply Finset.sum_congr rfl; intro i _; congr 1; exact funext fun w => (hy i w).trans (hu i w).symm
      _ = rawPair S u u := by
        conv_rhs => arg 2; unfold u
        rw [raw_sum_left]; simp_rw [port_adjoint]
  have ub := original_dominates S z u uv
  refine le_trans ?_ ub
  apply le_of_eq
  unfold u
  rw [raw_sum_left]; simp_rw [port_adjoint, outPair, hy]
  rw [Finset.sum_comm, Complex.re_sum]
  apply Finset.sum_congr rfl; intro w _
  let G := Routings.capGram d 2 (density S w)
  let Y := y (occupation w)
  change (quadratic G⁻¹ Y).re = (∑ i, star (τ (occupation w) i) * Y i).re
  have ht : τ (occupation w) = (G⁻¹).mulVec Y := by simp only [τ,G,Y,bagDensity_word]
  rw [ht]
  simp only [quadratic, Matrix.mulVec, dotProduct, star_sum, star_mul', Finset.sum_mul,
    Complex.re_sum, Complex.mul_re, Complex.mul_im, Complex.star_def, Complex.conj_re, Complex.conj_im]
  apply Finset.sum_congr rfl; intro i _
  apply Finset.sum_congr rfl; intro j _; ring

omit [Fintype D] in
/-- Equality of occupations is precisely the equivalence relation generated by
permutations of the word positions. -/
theorem exists_perm_of_occupation_eq {T : Type*} [Fintype T] {u v : T → D}
    (h : occupation u = occupation v) : ∃ σ : Equiv.Perm T, v ∘ σ = u := by
  classical
  have hc (f : T → D) (c : D) : (occupation f).count c = Fintype.card {i // f i = c} := by
    simp only [occupation, Multiset.count_sum', Fintype.card_subtype, Finset.card_filter]
    apply Finset.sum_congr rfl; intro i _
    by_cases hi : f i = c
    · simp [hi]
    · simp [Multiset.count_singleton,hi,Ne.symm hi]
  let e (c : D) := Fintype.equivOfCardEq (show Fintype.card {i // u i = c} = Fintype.card {i // v i = c} by
    rw [← hc, ← hc, h])
  exact ⟨Equiv.ofFiberEquiv e, funext (Equiv.ofFiberEquiv_map e)⟩

omit [Fintype D] [DecidableEq D] in
theorem port_symmetric (S : Finset D) (P : Finset (Option (Fin 4))) (z : Raw D)
    (w : Fin 4 → D) (σ : Equiv.Perm (Fin 4)) : portCap S P z (w ∘ σ) = portCap S P z w := by
  unfold portCap
  congr 1
  exact (Group.mulLeft_bijective σ).sum_comp (fun π : Equiv.Perm (Fin 4) =>
    ∑ a ∈ P, ∑ c ∈ S, z (insertAt a (w ∘ π) c) c)

/-- The ordered-word version of the exact Bessel estimate. Its outputs may
be supplied directly from a cap computation. All occupation invariance
needed by the estimate follows from the actual output clasp. -/
theorem ordered_port_bound (S : Finset D) (hS : S.card = 2) (P : J → Finset (Option (Fin 4))) (d : J → ℕ)
    (hs : ∀ i, (P i).card = d i+1) (hd : ∀ i j, i≠j → Disjoint (P i) (P j))
    (z : Raw D) (y : (Fin 4 → D) → J → ℂ) (hy : ∀ i w, portCap S (P i) z w = y w i) :
    (∑ w : Fin 4 → D, (quadratic (Routings.capGram d 2 (density S w))⁻¹ (y w)).re) ≤ rawEnergy S z := by
  classical
  let Y (B : Multiset D) := if h : ∃ w : Fin 4 → D, occupation w = B then y h.choose else 0
  have hY (w : Fin 4 → D) : Y (occupation w) = y w := by
    let h : ∃ w' : Fin 4 → D, occupation w' = occupation w := ⟨w,rfl⟩
    unfold Y
    rw [dif_pos h]
    change y h.choose = y w
    obtain ⟨σ,e⟩ := exists_perm_of_occupation_eq h.choose_spec
    exact (congrArg y e.symm).trans (by
      funext i
      rw [← hy, ← hy, port_symmetric])
  simpa only [hY] using word_port_bound S hS P d hs hd z Y (fun i w => (hy i w).trans (congrFun (hY w).symm i))

open FourQuadratic in
/-- The three Bessel estimates and the sector SOS bound combined, directly
on the supported raw halves of the three rows. -/
theorem four_word_bound (S : Finset D) (hS : S.card = 2)
    (PU PW : Fin 2 → Finset (Option (Fin 4))) (PV : Fin 1 → Finset (Option (Fin 4)))
    (hU : ∀ i, (PU i).card = d41 i + 1) (hW : ∀ i, (PW i).card = d23 i + 1)
    (hV : ∀ i, (PV i).card = d5 i + 1)
    (hDU : ∀ i j, i≠j → Disjoint (PU i) (PU j)) (hDW : ∀ i j, i≠j → Disjoint (PW i) (PW j))
    (U W V : Raw D) (x y : (Fin 4 → D) → ℂ)
    (hu : ∀ i t, portCap S (PU i) U t = ![y t,x t] i)
    (hw : ∀ i t, portCap S (PW i) W t = ![y t,fullCapMean 2 (x t) (y t)] i)
    (hv : ∀ i t, portCap S (PV i) V t = fullCapMean 3 (x t) (y t)) :
    0 ≤ 24 * rawEnergy S U + 144 * rawEnergy S W + 1080 * rawEnergy S V +
      ∑ t, (1350*Complex.normSq (fullCapMean 3 (x t) (y t)-x t/15) +
        108*Complex.normSq (fullCapMean 2 (x t) (y t))-36*Complex.normSq (x t)) := by
  have bu := ordered_port_bound S hS PU d41 hU hDU U (fun t => ![y t,x t]) hu
  have bw := ordered_port_bound S hS PW d23 hW hDW W (fun t => ![y t,fullCapMean 2 (x t) (y t)]) hw
  have bv := ordered_port_bound S hS PV d5 hV (fun i j hij => (hij (Subsingleton.elim _ _)).elim)
    V (fun t _ => fullCapMean 3 (x t) (y t)) hv
  have pos := supported_sector_pos (density S) (density_nonneg S) (density_le_one S) x y
  simp only [gramSector, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum] at pos ⊢
  linarith only [bu,bw,bv,pos]

end
end BlockPermanents.FourLastCaps
